--- !u!114 &1176724833
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1176724828}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 21009cdd90e92e44c985f9e9626e0e0f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  detailInfos:
  - "\uC800\uC7A5\uD560 \uACBD\uB85C\uB97C \uC120\uD0DD\uD574\uC8FC\uC138\uC694."
  - "\uD30C\uC77C\uC744 \uC800\uC7A5\uD558\uB294\uB370 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
  - "\uD504\uB85C\uC81D\uD2B8\uC758 \uC774\uB984\uC774 \uC9C0\uC815\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - "\uD504\uB85C\uC81D\uD2B8\uC758 \uC544\uD2F0\uC2A4\uD2B8\uAC00 \uC9C0\uC815\uB418\uC9C0
    \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - "\uD504\uB85C\uC81D\uD2B8\uC758 BPM\uC774 \uC9C0\uC815\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - "\uD504\uB85C\uC81D\uD2B8\uC758 \uBC30\uACBD\uC74C\uC774 \uC9C0\uC815\uB418\uC9C0
    \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - "\uD504\uB85C\uC81D\uD2B8\uC758 \uBC15\uC790\uAC00 \uC9C0\uC815\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - "\uD504\uB85C\uC81D\uD2B8\uC758 \uD45C\uC9C0\uAC00 \uC9C0\uC815\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - "\uD504\uB85C\uC81D\uD2B8\uC758 \uD0A4\uC74C \uD3F4\uB354\uAC00 \uC9C0\uC815\uB418\uC9C0
    \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - "\uC791\uC5C5\uC744 \uC218\uD589\uD558\uBA74 \uC800\uC7A5\uD558\uC9C0 \uC54A\uC740
    \uC791\uC5C5\uBB3C\uC774 \uC81C\uAC70\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBA3C\uC800
    \uC800\uC7A5\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  - "\uD30C\uC77C\uC744 \uBD88\uB7EC\uC624\uC9C0 \uBABB \uD588\uC2B5\uB2C8\uB2E4."
  - "\uACBD\uB85C\uB97C \uC124\uC815\uD558\uB358 \uC911 \uC624\uB958\uAC00 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4."
  - "\uB3D9\uC77C\uD55C \uC774\uB984\uC758 \uD3F4\uB354\uAC00 \uC874\uC7AC\uD569\uB2C8\uB2E4.
    \uB2E4\uB978 \uC774\uB984\uC73C\uB85C \uC124\uC815\uD574\uC8FC\uC138\uC694."
  - "\uC774\uBBF8 \uD574\uB2F9 \uAC8C\uC784\uBAA8\uB4DC\uC758 \uD14C\uB9C8\uAC00
    \uC788\uC2B5\uB2C8\uB2E4.\n\uC0AD\uC81C \uD6C4 \uB2E4\uC2DC \uC9C0\uC815\uD574\uC8FC\uC138\uC694."
  - "\uC774\uBBF8\uC9C0\uB97C \uBD88\uB7EC\uC624\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
  - "\uC0C8\uB85C\uC6B4 \uB514\uB809\uD1A0\uB9AC \uC0DD\uC131 \uBC0F \uB370\uC774\uD130
    \uC800\uC7A5\uC744 \uC644\uB8CC\uD558\uC600\uC2B5\uB2C8\uB2E4."
  - "\uAE30\uC874 \uD504\uB85C\uC81D\uD2B8\uC758 \uC815\uBCF4\uB97C \uC218\uC815\uD558\uC600\uC2B5\uB2C8\uB2E4."
  - "\uC815\uB9D0 \uD504\uB85C\uC81D\uD2B8\uB97C \uC0AD\uC81C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  - "\uC720\uD6A8\uD558\uC9C0 \uC54A\uC740 \uD30C\uC77C\uC774 \uC874\uC7AC\uD569\uB2C8\uB2E4."
  - "\uC5D0\uB514\uD130\uB97C \uC885\uB8CC\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  detail_tmp: {fileID: 271026340}
